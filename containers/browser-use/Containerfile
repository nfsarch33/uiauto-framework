# browser-use executor lane for uiauto-framework (MIT, browser-use.dev).
#
# browser-use is the LLM-driven executor: it takes a natural-language task,
# drives an existing Chromium over CDP, and returns the run history. The
# decision layer (containers/laya) picks WHAT to do; this lane (or the
# chromedp lane) DOES it. Pinned so the image is reproducible; the
# transitive freeze lands in /versions.txt for build-to-build diffing.
#
# No browser binaries are installed: the service attaches to an existing
# Chromium over CDP (cdp_url) and never launches one -- one shared browser
# session per host, per fleet policy.
FROM python:3.12-slim

ARG BROWSER_USE_VERSION=0.13.10

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir browser-use==${BROWSER_USE_VERSION} langchain-openai \
 && pip freeze > /versions.txt

COPY server.py /server.py
COPY smoke.py /smoke.py
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=5)"
ENTRYPOINT ["python", "/server.py"]
